page {
  background: #f5f5f5;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.container {
  padding: 32rpx;
}
.btn-primary {
  background: #07c160;
  color: #fff;
}
.tip {
  margin-top: 24rpx;
  color: #888;
  font-size: 28rpx;
  text-align: center;
}
.link {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  color: #576b95;
  font-size: 30rpx;
}
.result-list {
  margin-top: 32rpx;
}
.result-item {
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.result-item.ok {
  border-left: 8rpx solid #07c160;
}
.result-item.fail {
  border-left: 8rpx solid #fa5151;
}
.result-item .msg {
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}
