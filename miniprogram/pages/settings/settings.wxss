.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.acct-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.acct-info {
  display: flex;
  flex-direction: column;
}
.acct-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.acct-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #999;
}
.acct-btns {
  display: flex;
  gap: 10rpx;
}
.row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.label {
  width: 100rpx;
  color: #333;
  font-size: 28rpx;
}
.input,
.picker {
  flex: 1;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}
.textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin: 12rpx 0;
  box-sizing: border-box;
}
.tip {
  margin-top: 16rpx;
  color: #999;
  font-size: 23rpx;
  text-align: center;
}
.tip-left {
  color: #999;
  font-size: 23rpx;
}
