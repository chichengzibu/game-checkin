.acct-list {
  margin-top: 32rpx;
}
.acct-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.acct-card.disabled {
  opacity: 0.5;
}
.acct-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.acct-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.acct-plat {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.acct-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #888;
}
.acct-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
